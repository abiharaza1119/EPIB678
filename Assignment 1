#Display it nicely
t_params |>
  flextable() |> #turn into flextable object
  merge_v(j=1) |> #Merge cells in first column with same value (group probabilities, costs, etc.)
  theme_box() |> #Apply a theme for aesthetics
  autofit() #automatically set column widths to reasonable values
```

In the code chunk below, build the model using the rdecision package with the 'base_case' value for each parameter (we won't be using the 'lower_bound' or 'upper_bound' columns in this assignment).

Your model should start with a decision mode with three options:

-   **OTSc first:** use OTS clip for first line therapy. If a rebleed occurs, use a standard clip for second line therapy

-   **ST first:** use a standard clip for first line therapy. If a rebleed occurs, use an OTS clip for second line therapy

-   **ST only**: use a standard clip for first line therapy and, if a rebleed occurs, for second line therapy.

All three branches from this decision node ("actions" in the rdecision package) lead into a chance node corresponding to the outcomes of the first line EGD. From this initial chance node, there are two possibilities:

-   **Success:** no re-bleeding occurs after the first line procedure (ends in a leaf node \[also called terminal node\]).

-   **Second-line therapy:** A second EGD is needed to try and close the peptic ulcer bleed (leads to a chance node corresponding to the outcome of the second line EGD).

After second-line therapy, you have another chance node with two possibilities:

-   **Success:** second line therapy worked (ends in a leaf node).

-   **Further bleeding; IR procedure needed:** After 2 failed EGDs, patients undergo an interventional radiology procedure, which we assume is always successful (ends in a leaf node).

**Costs:** You will accumulate costs along the action and reaction paths:

-   In the actions from this initial decision node, patients incur the cost for the physician fee to do the EGD (`c_EGD_MD`) and the cost of whichever clip was used first under that policy (`c_STclip` or `c_OTSclip`)

-   If the first line EGD was successful, we add in the cost of a hospitalization with no major complications or comorbidities (`c_hosp_noCC`).

-   If the first line EGD was unsuccessful then we must perform a second-line EGD, incurring the cost of a second clip (`c_STclip` or `c_OTSclip`, depending on the strategy) and the physician fee for the second procedure (`c_EGD_MD`).

-   If the second line EGD was successful, we add in the cost of a hospitalization with minor complications and comorbidities (`c_hosp_CC`)

-   If the second line EGD was unsuccessful and an IR procedure was needed, we add in the cost of the IR physician fee (`c_IR_MD`), and the cost of a hospitalization with major complications/comorbidities (`c_hosp_MCC`).

**Quality-adjusted life years:** We will use rdecision's default time horizon of one year. You will need to assign one of the three parameters `q_single_EGD`, `q_double_EGD`, and `q_IR` as the utility at each leaf node, depending on which procedures the patient underwent in order to arrive at that leaf. Note that `q_IR` already factors in the QALY loss from the two failed EGDs that occurred before the interventional radiology procedure.

Tips:

-   Draw the tree on paper before you start coding it.

-   Focus on tree structure and probabilities first, plot it, and then add costs and utilities.

```{r}
# I like to turn the parameters from my table into  a named list
# Then I can refer to the parameter I want by, e.g., `params$c_OTS`
params <- as.list(t_params$base_case)
names(params) <- t_params$name

#Create root decision node
decision_node <- DecisionNode$new("Clip strategy")

# Create chance nodes for whether first-line therapy was successful in each scenario
chance_first_otsc_first <- ChanceNode$new("1st-line outcome (OTSc first)")
chance_first_st_first   <- ChanceNode$new("1st-line outcome (ST first)")
chance_first_st_only    <- ChanceNode$new("1st-line outcome (ST only)")

#Create chance nodes for whether second-line therapy was successful in each scenario
chance_second_otsc_first <- ChanceNode$new("2nd-line outcome (OTSc first)")
chance_second_st_first   <- ChanceNode$new("2nd-line outcome (ST first)")
chance_second_st_only    <- ChanceNode$new("2nd-line outcome (ST only)")

#Create leaf nodes
# (9 total. "1st line success", "2nd line success", and "IR needed" for each scenario)

# OTSc first (OTSc then ST)
leaf_otsc_first_1_success <- LeafNode$new("OTSc first: 1st-line success", utility = params$q_single_EGD)
leaf_otsc_first_2_success <- LeafNode$new("OTSc first: 2nd-line success", utility = params$q_double_EGD)
leaf_otsc_first_ir        <- LeafNode$new("OTSc first: IR needed",        utility = params$q_IR)

# ST first (ST then OTSc)
leaf_st_first_1_success <- LeafNode$new("ST first: 1st-line success", utility = params$q_single_EGD)
leaf_st_first_2_success <- LeafNode$new("ST first: 2nd-line success", utility = params$q_double_EGD)
leaf_st_first_ir        <- LeafNode$new("ST first: IR needed",        utility = params$q_IR)

# ST only (ST then ST)
leaf_st_only_1_success <- LeafNode$new("ST only: 1st-line success", utility = params$q_single_EGD)
leaf_st_only_2_success <- LeafNode$new("ST only: 2nd-line success", utility = params$q_double_EGD)
leaf_st_only_ir        <- LeafNode$new("ST only: IR needed",        utility = params$q_IR)

#Create 'actions', paths from your decision node(s).
# (Costs here: first EGD MD fee + cost of first-line clip)

action_otsc_first <- Action$new(
  decision_node, chance_first_otsc_first,
  cost = params$c_EGD_MD + params$c_OTSclip,
  label = "OTSc first"
)

action_st_first <- Action$new(
  decision_node, chance_first_st_first,
  cost = params$c_EGD_MD + params$c_STclip,
  label = "ST first"
)

action_st_only <- Action$new(
  decision_node, chance_first_st_only,
  cost = params$c_EGD_MD + params$c_STclip,
  label = "ST only"
)

#Create 'reactions', paths from your chance node(s)
# 12 total:
#  - Reactions for success after first-line therapy
#  - Reactions for failure (rebleed) after first-line therapy
#  - Reactions for success after second-line therapy
#  - Reactions for failure (IR needed) after second-line therapy

#First line success:
r_otsc_first_success <- Reaction$new(
  chance_first_otsc_first, leaf_otsc_first_1_success,
  p = 1 - params$p_OTSc_rebleed, cost = params$c_hosp_noCC,
  label = "Success (no rebleed)"
)

r_st_first_success <- Reaction$new(
  chance_first_st_first, leaf_st_first_1_success,
  p = 1 - params$p_ST_rebleed, cost = params$c_hosp_noCC,
  label = "Success (no rebleed)"
)

r_st_only_success <- Reaction$new(
  chance_first_st_only, leaf_st_only_1_success,
  p = 1 - params$p_ST_rebleed, cost = params$c_hosp_noCC,
  label = "Success (no rebleed)"
)

#First line failure:
r_otsc_first_failure <- Reaction$new(
  chance_first_otsc_first, chance_second_otsc_first,
  p = params$p_OTSc_rebleed, cost = params$c_EGD_MD + params$c_STclip,
  label = "Rebleed → 2nd EGD (ST)"
)

# ST first → 2nd line uses OTSc
r_st_first_failure <- Reaction$new(
  chance_first_st_first, chance_second_st_first,
  p = params$p_ST_rebleed, cost = params$c_EGD_MD + params$c_OTSclip,
  label = "Rebleed → 2nd EGD (OTSc)"
)

# ST only → 2nd line uses ST
r_st_only_failure <- Reaction$new(
  chance_first_st_only, chance_second_st_only,
  p = params$p_ST_rebleed, cost = params$c_EGD_MD + params$c_STclip,
  label = "Rebleed → 2nd EGD (ST)"
)

#Second line success:
r_otsc_second_success <- Reaction$new(
  chance_second_otsc_first, leaf_otsc_first_2_success,
  p = 1 - params$p_ST_rpt_IR, cost = params$c_hosp_CC,
  label = "2nd-line success"
)

# success prob = 1 - p_OTSc_rpt_IR
r_st_second_success <- Reaction$new(
  chance_second_st_first, leaf_st_first_2_success,
  p = 1 - params$p_OTSc_rpt_IR, cost = params$c_hosp_CC,
  label = "2nd-line success"
)

# success prob = 1 - p_ST_rpt_IR
r_st_only_second_success <- Reaction$new(
  chance_second_st_only, leaf_st_only_2_success,
  p = 1 - params$p_ST_rpt_IR, cost = params$c_hosp_CC,
  label = "2nd-line success"
)

#Second line failure:
r_otsc_second_failure <- Reaction$new(
  chance_second_otsc_first, leaf_otsc_first_ir,
  p = params$p_ST_rpt_IR, cost = params$c_IR_MD + params$c_hosp_MCC,
  label = "Further bleed → IR"
)

r_st_second_failure <- Reaction$new(
  chance_second_st_first, leaf_st_first_ir,
  p = params$p_OTSc_rpt_IR, cost = params$c_IR_MD + params$c_hosp_MCC,
  label = "Further bleed → IR"
)

r_st_only_second_failure <- Reaction$new(
  chance_second_st_only, leaf_st_only_ir,
  p = params$p_ST_rpt_IR, cost = params$c_IR_MD + params$c_hosp_MCC,
  label = "Further bleed → IR"
)

#Create the tree
DT2 <- DecisionTree$new(
  V = list(
    decision_node,
    chance_first_otsc_first, chance_first_st_first, chance_first_st_only,
    chance_second_otsc_first, chance_second_st_first, chance_second_st_only,
    leaf_otsc_first_1_success, leaf_otsc_first_2_success, leaf_otsc_first_ir,
    leaf_st_first_1_success,   leaf_st_first_2_success,   leaf_st_first_ir,
    leaf_st_only_1_success,    leaf_st_only_2_success,    leaf_st_only_ir
  ),
  E = list(
    action_otsc_first, action_st_first, action_st_only,
    r_otsc_first_success, r_st_first_success, r_st_only_success,
    r_otsc_first_failure, r_st_first_failure, r_st_only_failure,
    r_otsc_second_success, r_st_second_success, r_st_only_second_success,
    r_otsc_second_failure, r_st_second_failure, r_st_only_second_failure
  )
)

# Draw the tree (uncomment after completing earlier steps)
DT2$draw()

# Create table with the expected cost and utility (in QALYs or QALD) of each alternative
DT2_evaluation <- DT2$evaluate() #calculate it
DT2_evaluation |> flextable()

```

